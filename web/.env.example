# Supabase (Settings → API). La anon/publishable key es pública: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA para el resumen semanal (opcional, gratis): https://console.groq.com/keys
# Sólo del lado del servidor: NUNCA con prefijo NEXT_PUBLIC_. Sin clave, se usa una plantilla.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
